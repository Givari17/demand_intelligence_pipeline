# Salin ke .env (jangan commit .env asli — sudah ada di .gitignore).
# Di GitHub Codespaces, lebih aman set ini sebagai Codespaces secret
# (Settings > Secrets and variables > Codespaces) daripada file .env.

YOUTUBE_API_KEY=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=DEMAND_INTELLIGENCE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Dipakai container Grafana untuk login awal
GF_SECURITY_ADMIN_PASSWORD=admin
